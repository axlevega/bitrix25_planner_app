# Database (MySQL) — не попадают в git; на сервере задать в .env или backend/.env.local
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bitrix25_planner
DB_USER=bitrix25_planner
DB_PASSWORD=

# Bitrix24 (webhook URL содержит токен; в MVP OAuth не используется)
# Пример: https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxx/
BITRIX24_WEBHOOK_URL=

# Frontend API base URL (для разработки)
VITE_API_BASE_URL=http://localhost:8000/api

# FTP (для npm run deploy; не коммитить пароль)
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21
# FTP_SECURE=true для FTPS (TLS)
# FTP_SECURE=
# Путь на сервере (например /public_html или /)
FTP_REMOTE_DIR=/
# Подкаталоги: бэкенд и статика фронта (относительно FTP_REMOTE_DIR)
FTP_REMOTE_BACKEND=backend
FTP_REMOTE_FRONTEND=public
