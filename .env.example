# Database (MySQL) — не попадают в git; на сервере задать в .env или backend/.env.local
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bitrix25_planner
DB_USER=bitrix25_planner
DB_PASSWORD=

# Bitrix24 (webhook URL содержит токен; в MVP OAuth не используется)
# Пример: https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxx/
BITRIX24_WEBHOOK_URL=

# Период задач по дате создания (дней). Задачи старше этого срока не подтягиваются; учёт времени (elapsed) тянется только по этим задачам.
# 60 = ~2 месяца, 90 = ~3 месяца. По умолчанию 365. Раскомментируйте и задайте значение, чтобы ускорить синхронизацию.
# TASKS_DAYS_BACK=60

# Лимит для теста синхронизации: загружать только N задач и N пользователей (0 = без лимита)
# SYNC_LIMIT=10

# Frontend API base URL (для разработки)
VITE_API_BASE_URL=http://localhost:8000/api

# FTP (для npm run deploy; не коммитить пароль)
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21
# FTP_SECURE=true для FTPS (TLS)
# FTP_SECURE=
# Путь на сервере (например /public_html или /)
FTP_REMOTE_DIR=/
# Подкаталоги: бэкенд и статика фронта (относительно FTP_REMOTE_DIR)
FTP_REMOTE_BACKEND=backend
FTP_REMOTE_FRONTEND=public
